# --- LLM (required to run investigations) ---------------------------------
# Provider: "groq", "xai" (Grok) or "openai". Only the selected provider's key is needed.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

XAI_API_KEY=
XAI_MODEL=grok-4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set to "none" for reasoning models that do not accept a temperature.
LLM_TEMPERATURE=0
# For reasoning models (gpt-oss, o-series): low | medium | high, or none to omit.
LLM_REASONING_EFFORT=low

# --- LangSmith tracing (optional) -----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-troubleshooter

# --- Tools ----------------------------------------------------------------
ENABLE_CODE_EXECUTION=true
SANDBOX_TIMEOUT_S=5
ENABLE_GITHUB_SEARCH=true
# Optional; raises the GitHub search rate limit from 10 to 30 requests/minute.
GITHUB_TOKEN=

# --- Retrieval and control flow -------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=8
MIN_RELEVANT_CHUNKS=2
MAX_REVISIONS=1
